{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "C64KBManifest",
  "type": "object",
  "required": ["version", "documents_count", "dataset_hash"],
  "properties": {
    "version": {
      "type": "string",
      "description": "SemVer version of the KB release (e.g., 2.1.0)"
    },
    "release_notes": {
      "type": "string"
    },
    "documents_count": {
      "type": "integer"
    },
    "dataset_hash": {
      "type": "string"
    },
    "last_sync": {
      "type": "string"
    }
  }
}
